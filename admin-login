<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>OMEGA TRADE CENTER | Admin Login</title>
<link rel="stylesheet" href="style.css">
<style>
.login-wrap{min-height:calc(100vh - 90px);display:grid;place-items:center;padding:30px 20px;background:#f5f6f8}.login-card{width:min(430px,100%);background:#fff;border:1px solid #e2e4e8;border-radius:18px;padding:32px;box-shadow:0 15px 40px rgba(0,0,0,.08)}.login-icon{width:62px;height:62px;border-radius:16px;background:#101318;color:#f4b400;display:grid;place-items:center;font-size:32px;margin-bottom:18px}.login-card h1{margin:0 0 8px}.login-card p{color:#6c727d;line-height:1.5}.login-card label{display:block;font-weight:700;margin:22px 0 8px}.login-card input{width:100%;padding:13px;border:1px solid #dfe2e6;border-radius:9px;font-size:16px}.login-btn{width:100%;margin-top:16px;border:0;border-radius:9px;padding:13px;background:#101318;color:#fff;font-weight:700;cursor:pointer}.error{color:#c62828!important;min-height:22px;margin:12px 0 0}.back-link{display:block;text-align:center;margin-top:18px;color:#555;font-weight:700}
</style>
</head>
<body>
<header><div class="wrap nav"><div class="brand"><div class="logo">Ω</div><div><b>OMEGA TRADE CENTER</b><small>Admin Access</small></div></div></div></header>
<main class="login-wrap"><section class="login-card"><div class="login-icon">🔐</div><h1>Admin Login</h1><p>Enter the admin password to manage Omega Trade Center products.</p><form id="loginForm"><label for="password">Admin Password</label><input id="password" type="password" autocomplete="current-password" required autofocus><button class="login-btn" type="submit">Login to Admin</button><p class="error" id="error"></p></form><a class="back-link" href="index.html">← Back to Product Catalog</a></section></main>
<script>
// CHANGE THIS PASSWORD before publishing. This simple client-side gate is convenient,
// but it is not equivalent to server-side authentication.
const ADMIN_PASSWORD = 'OmegaAdmin123!';
if(sessionStorage.getItem('omegaAdminUnlocked')==='yes') location.replace('admin.html');
document.getElementById('loginForm').addEventListener('submit',e=>{e.preventDefault();const p=document.getElementById('password').value;if(p===ADMIN_PASSWORD){sessionStorage.setItem('omegaAdminUnlocked','yes');location.replace('admin.html')}else{document.getElementById('error').textContent='Incorrect password. Please try again.';document.getElementById('password').value='';document.getElementById('password').focus()}});
</script>
</body></html>
